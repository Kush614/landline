# ---- core ----
PORT=3000
BASE_URL=https://landline-api.onrender.com

# ---- Linq (iMessage storefront) ----
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
LINQ_WEBHOOK_SECRET=
LINQ_AUTO_SUBSCRIBE=false

# ---- Stripe (one payment link, all day) ----
STRIPE_PAYMENT_LINK=
STRIPE_READ_KEY=            # rk_ restricted read key, dashboard only

# ---- Terac (human preference studies) ----
TERAC_API_KEY=
TERAC_PROJECT_ID=           # optional; created on first run if blank
TERAC_PARTICIPANTS=5          # Terac bills ~$4.50/participant, per shipped site
TERAC_INLINE_WAIT_MS=120000 # how long the pipeline waits before shipping the model pick
TERAC_MIN_VOTES=3
TERAC_MAX_COST_CENTS=2500     # pipeline refuses to auto-launch a study above this
# Confirmed against the live API:
TERAC_TASK_TYPE=activity      # interview | file_upload | activity
TERAC_REVIEW_TYPE=auto_approve # auto_approve | manual_review | self_report

# ---- Replay (QA) ----
REPLAY_API_KEY=
REPLAY_WAIT_MS=180000

# ---- Superserve (per-order VM) ----
SUPERSERVE_API_KEY=

# ---- Pioneer (open-weight copy + PII scrub) ----
PIONEER_API_KEY=
PIONEER_COPY_MODEL=meta-llama/Llama-3.3-70B-Instruct   # open-weight; verified in /v1/models
PIONEER_PII_MODEL=fastino/gliner2-privacy-filter-PII-multi

# ---- Band (agent coordination) ----
BAND_API_KEY=
BAND_AGENT_ID=
BAND_ROOM_ID=
BAND_ENABLED=true

# ---- Render ----
RENDER_API_KEY=
RENDER_OWNER_ID=

# ---- light integrations ----
FEATURE_WHOP=false
FEATURE_EGOIST=false
FEATURE_SOLARI=false
FEATURE_SANDBOX0=false
